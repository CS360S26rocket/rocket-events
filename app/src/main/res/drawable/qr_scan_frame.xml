<?xml version="1.0" encoding="utf-8"?>
<!--
    qr_scan_frame.xml
    Place at: res/drawable/qr_scan_frame.xml

    Draws four corner brackets to guide the user's QR positioning.
    No fill — the camera preview shows through.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Top-left corner -->
    <item android:top="0dp" android:left="0dp" android:bottom="220dp" android:right="220dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#FFFFFF" />
            <solid android:color="@android:color/transparent" />
            <corners android:topLeftRadius="4dp" />
        </shape>
    </item>

    <!-- Top-right corner -->
    <item android:top="0dp" android:left="220dp" android:bottom="220dp" android:right="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#FFFFFF" />
            <solid android:color="@android:color/transparent" />
            <corners android:topRightRadius="4dp" />
        </shape>
    </item>

    <!-- Bottom-left corner -->
    <item android:top="220dp" android:left="0dp" android:bottom="0dp" android:right="220dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#FFFFFF" />
            <solid android:color="@android:color/transparent" />
            <corners android:bottomLeftRadius="4dp" />
        </shape>
    </item>

    <!-- Bottom-right corner -->
    <item android:top="220dp" android:left="220dp" android:bottom="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#FFFFFF" />
            <solid android:color="@android:color/transparent" />
            <corners android:bottomRightRadius="4dp" />
        </shape>
    </item>

</layer-list>