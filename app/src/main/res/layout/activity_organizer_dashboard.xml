<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎟️ Organizer Dashboard"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:fontFamily="@font/poppins_bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Create your event, set sales timing, and view attendees."
            android:textColor="@color/accent_lime_soft"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular" />

        <View
            android:layout_width="56dp"
            android:layout_height="4dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Create Event"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Set up the basics first."
                android:textColor="@color/accent_lime"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_regular" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Event title"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_regular" />

            <EditText
                android:id="@+id/etEventTitle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_dark"
                android:fontFamily="@font/poppins_regular"
                android:hint="Enter event title"
                android:inputType="textCapSentences"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/hint_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Description"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_regular" />

            <EditText
                android:id="@+id/etEventDesc"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_dark"
                android:fontFamily="@font/poppins_regular"
                android:gravity="top|start"
                android:hint="Write a short event description"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/hint_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Venue"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_regular" />

            <Spinner
                android:id="@+id/spinnerVenue"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_dark"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:spinnerMode="dropdown" />

            <Button
                android:id="@+id/btnPickDate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="@font/poppins_bold"
                android:stateListAnimator="@null"
                android:text="Pick Event Date"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnCreateEvent"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="@font/poppins_bold"
                android:stateListAnimator="@null"
                android:text="Create Event"
                android:textAllCaps="false"
                android:textColor="@color/button_text_dark"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📈 Manage Sales and Attendees"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="These controls work after an event is created."
                android:textColor="@color/accent_lime"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_regular" />

            <Button
                android:id="@+id/btnPickSalesStart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="@font/poppins_bold"
                android:stateListAnimator="@null"
                android:text="Pick Sales Start"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnPickSalesEnd"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="@font/poppins_bold"
                android:stateListAnimator="@null"
                android:text="Pick Sales End"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnSetSales"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="@font/poppins_bold"
                android:stateListAnimator="@null"
                android:text="Set Sales Timing"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnViewAttendees"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="@font/poppins_bold"
                android:stateListAnimator="@null"
                android:text="View Attendees"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDashboardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_card_dark"
            android:fontFamily="@font/poppins_regular"
            android:minHeight="96dp"
            android:padding="16dp"
            android:text="Status updates will appear here."
            android:textColor="@color/accent_lime"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>