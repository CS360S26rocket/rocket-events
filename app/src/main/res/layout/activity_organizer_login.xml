<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Small label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Organizer Login"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_regular" />

    <!-- Main heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Manage events."
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:fontFamily="@font/poppins_bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Create, edit, track RSVPs"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_regular" />

    <!-- Email label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Email"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_regular" />

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_dark"
        android:fontFamily="@font/poppins_regular"
        android:hint="business@email.com"
        android:inputType="textEmailAddress"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/hint_text"
        android:textSize="14sp" />

    <!-- Password label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Password"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_regular" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_dark"
        android:fontFamily="@font/poppins_regular"
        android:hint="••••••••"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/hint_text"
        android:textSize="14sp" />

    <!-- Log In button -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_button_primary"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:fontFamily="@font/poppins_bold"
        android:stateListAnimator="@null"
        android:text="Log In"
        android:textAllCaps="false"
        android:textColor="@color/button_text_dark"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/error_red"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_regular"
        android:visibility="gone" />

    <!-- Sign up link -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New society? "
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular" />

        <TextView
            android:id="@+id/tvSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register here"
            android:textColor="@color/accent_lime"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
