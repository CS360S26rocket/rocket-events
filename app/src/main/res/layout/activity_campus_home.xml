<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    android:paddingTop="56dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tvCampusTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="Events"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="142dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_dark"
            android:fontFamily="@font/poppins_regular"
            android:hint="Search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/hint_text"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCampusSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Here you'll find all active Scene events"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/sectionHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Categories"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipAll"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_button_primary"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:minWidth="82dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="All"
                            android:textColor="@color/button_text_dark"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipEntertainment"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_button_ghost"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:minWidth="132dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Entertainment"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipSeminars"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_button_ghost"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:minWidth="104dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Seminars"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipSports"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_button_ghost"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:minWidth="92dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Sports"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipWorkshops"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_button_ghost"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:minWidth="120dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Workshops"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Ticket type"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipPriceAll"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="All"
                        android:textColor="@color/button_text_dark"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipFree"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_ghost"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="Free"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipPaid"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_ghost"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="Paid"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSortEarliest"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_ghost"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/poppins_bold"
                    android:stateListAnimator="@null"
                    android:text="Sort by Earliest"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Popular"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/listEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/sectionMyEvents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/listMyEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="18dp" />
        </ScrollView>

        <ScrollView
            android:id="@+id/sectionNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/listNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="18dp" />
        </ScrollView>

        <ScrollView
            android:id="@+id/sectionProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="34dp">

                <TextView
                    android:id="@+id/tvProfileInitials"
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:background="@drawable/bg_icon_button"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:text="CU"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:text="Campus User"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="student@email.com"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etProfileName"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_input_dark"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Full name"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint_text"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etProfilePassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_dark"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="New password"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint_text"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/poppins_bold"
                    android:stateListAnimator="@null"
                    android:text="Save Profile"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_dark"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvProfileInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:fontFamily="@font/poppins_regular"
                    android:padding="14dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSignOut"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_ghost"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/poppins_bold"
                    android:stateListAnimator="@null"
                    android:text="Log out"
                    android:textAllCaps="false"
                    android:textColor="@color/error_red"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>

        <ImageButton
            android:id="@+id/btnAiAssistant"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_scene_fab"
            android:clickable="true"
            android:contentDescription="Open AI event assistant"
            android:elevation="8dp"
            android:focusable="true"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_scene_s_logo_dark" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_dark"
        android:fontFamily="@font/poppins_regular"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/navCampus"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item_active"
            android:clickable="true"
            android:contentDescription="Home"
            android:drawableTop="@drawable/ic_nav_home"
            android:drawableTint="@color/text_primary"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="" />

        <TextView
            android:id="@+id/navMyEvents"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="My Events"
            android:drawableTop="@drawable/ic_nav_ticket"
            android:drawableTint="@color/text_secondary"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="" />

        <TextView
            android:id="@+id/navNotifications"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Notifications"
            android:drawableTop="@drawable/ic_nav_bell"
            android:drawableTint="@color/text_secondary"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Profile"
            android:drawableTop="@drawable/ic_nav_user"
            android:drawableTint="@color/text_secondary"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="" />
    </LinearLayout>

</LinearLayout>
